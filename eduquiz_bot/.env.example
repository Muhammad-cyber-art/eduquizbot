# EduQuiz Bot — Production Environment Variables Template
# =========================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values marked as REQUIRED
# 3. NEVER commit .env to version control
#
# Generate secure random values:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ============================================================
# REQUIRED — Bot will refuse to start without these
# ============================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# PostgreSQL connection (for Docker: use host "db"; for local: use "localhost")
DATABASE_URL=postgresql+asyncpg://eduquiz:STRONG_DB_PASSWORD@db:5432/eduquiz

# PostgreSQL credentials (must match DATABASE_URL)
POSTGRES_USER=eduquiz
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=eduquiz

# Redis password (required — no default allowed in production)
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD

# Redis URL (for Docker: redis://:PASSWORD@redis:6379/0)
REDIS_URL=redis://:CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD@redis:6379/0

# Admin panel credentials — USE STRONG, UNIQUE VALUES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# JWT Secret — 64-character hex string
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_A_64_CHAR_HEX_STRING_HERE

# Webhook secret — used to validate incoming Telegram webhook requests
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: must be consistent across restarts in webhook mode
WEBHOOK_SECRET=GENERATE_A_64_CHAR_HEX_STRING_HERE

# ============================================================
# DEPLOYMENT CONFIGURATION
# ============================================================

# Your server's public URL (HTTPS required for production)
# Example: https://yourdomain.com
WEB_URL=https://yourdomain.com

# Telegram webhook URL (same as WEB_URL for standard setup)
# Leave EMPTY for local development (uses polling mode instead)
# Example: https://yourdomain.com
WEBHOOK_URL=https://yourdomain.com

# Webhook path (default is correct for standard setup)
WEBHOOK_PATH=/api/webhook

# ============================================================
# OPTIONAL
# ============================================================

# Production vs Development (set to "production" on VPS)
APP_ENV=production

# Log level (INFO recommended for production, DEBUG for troubleshooting)
LOG_LEVEL=INFO

# Default language (uz, ru, en)
LANG_DEFAULT=uz

# Gemini AI API Key (for AI-powered quiz generation feature)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Your Telegram Chat ID for admin notifications
# How to find it: message @userinfobot in Telegram
ADMIN_CHAT_ID=

# SOCKS5 proxy (if Telegram API is blocked in your region)
# Format: socks5://user:pass@host:port
PROXY_URL=

# Internal FastAPI port (do not expose to internet — Nginx proxies to it)
WEB_PORT=8001
