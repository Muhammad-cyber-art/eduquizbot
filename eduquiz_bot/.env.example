# EduQuiz Bot — Environment Variables Example
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control!

# ============================================================
# REQUIRED
# ============================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# PostgreSQL connection string
# For Docker: use service name "db" instead of "localhost"
DATABASE_URL=postgresql+asyncpg://eduquiz:STRONG_DB_PASSWORD@db:5432/eduquiz

# PostgreSQL credentials (must match DATABASE_URL above)
POSTGRES_USER=eduquiz
POSTGRES_PASSWORD=STRONG_DB_PASSWORD_HERE
POSTGRES_DB=eduquiz

# Admin panel credentials — USE STRONG VALUES!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_AND_PASTE_A_64_CHAR_HEX_STRING_HERE

# ============================================================
# OPTIONAL
# ============================================================

# Production vs Development mode
# Set to "production" on server, "development" locally
APP_ENV=production

# Your server's public URL (used for CORS and WebApp button)
# Example: https://yourdomain.com
WEB_URL=https://yourdomain.com

# Webhook URL for Telegram (your public server URL)
# Leave empty to use polling mode (for local dev)
# Example: https://yourdomain.com
WEBHOOK_URL=https://yourdomain.com

# Webhook path (default is fine)
WEBHOOK_PATH=/api/webhook

# Redis URL (for FSM storage)
REDIS_URL=redis://localhost:6379/0

# Language (uz, ru, en)
LANG_DEFAULT=uz

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Gemini AI API Key (for AI-powered question generation)
GEMINI_API_KEY=

# Your personal Telegram Chat ID — used to notify you when a teacher submits a request
# How to find it: message @userinfobot in Telegram, it replies with your chat ID
ADMIN_CHAT_ID=

# Proxy (if Telegram is blocked in your region)
PROXY_URL=

# Web/Admin panel port
WEB_PORT=8001
